{
    "name": "rhodecode-vscode-extension",
    "displayName": "RhodeCode",
    "description": "Work with RhodeCode pull requests and comments: view, reply, mark handled, approve, merge.",
    "version": "0.2.0",
    "publisher": "isaackehle",
    "repository": {
        "type": "git",
        "url": "https://github.com/isaackehle/rhodecode-vscode-extension.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "rhodecode.refresh",
                "title": "Refresh",
                "category": "RhodeCode",
                "icon": "$(refresh)"
            },
            {
                "command": "rhodecode.showPullRequests",
                "title": "Show Pull Requests",
                "category": "RhodeCode",
                "icon": "$(git-pull-request)"
            },
            {
                "command": "rhodecode.showComments",
                "title": "Show Comments",
                "category": "RhodeCode",
                "icon": "$(comment)"
            },
            {
                "command": "rhodecode.replyComment",
                "title": "Reply to Comment",
                "category": "RhodeCode",
                "icon": "$(reply)"
            },
            {
                "command": "rhodecode.markHandled",
                "title": "Mark Comment Handled",
                "category": "RhodeCode",
                "icon": "$(check)"
            },
            {
                "command": "rhodecode.markUnhandled",
                "title": "Mark Comment Unhandled",
                "category": "RhodeCode",
                "icon": "$(circle-outline)"
            },
            {
                "command": "rhodecode.createPullRequest",
                "title": "Create Pull Request",
                "category": "RhodeCode",
                "icon": "$(git-pull-request-create)"
            },
            {
                "command": "rhodecode.openPullRequest",
                "title": "Open Pull Request in Browser",
                "category": "RhodeCode",
                "icon": "$(globe)"
            },
            {
                "command": "rhodecode.approveAndMerge",
                "title": "Approve and Merge",
                "category": "RhodeCode",
                "icon": "$(git-merge)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "rhodecode",
                    "title": "RhodeCode",
                    "icon": "media/rhodecode-icon.svg"
                }
            ]
        },
        "views": {
            "rhodecode": [
                {
                    "id": "rhodecode.pullRequests",
                    "name": "Pull Requests",
                    "icon": "media/rhodecode-icon.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "rhodecode.refresh",
                    "when": "view == rhodecode.pullRequests",
                    "group": "navigation"
                },
                {
                    "command": "rhodecode.showPullRequests",
                    "when": "view == rhodecode.pullRequests",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "rhodecode.showComments",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest",
                    "group": "inline"
                },
                {
                    "command": "rhodecode.openPullRequest",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest",
                    "group": "inline"
                },
                {
                    "command": "rhodecode.approveAndMerge",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest",
                    "group": "inline"
                }
            ]
        },
        "configuration": [
            {
                "title": "RhodeCode Configuration",
                "properties": {
                    "rhodecode.serverurl": {
                        "title": "Your RhodeCode server URL",
                        "type": "string",
                        "default": ""
                    },
                    "rhodecode.apikey": {
                        "title": "Your RhodeCode API key",
                        "type": "string",
                        "default": ""
                    },
                    "rhodecode.repoid": {
                        "title": "The repository to use (workspace setting)",
                        "type": "string",
                        "default": ""
                    },
                    "rhodecode.markHandledPostsComment": {
                        "title": "Post a reply comment on the PR when marking a comment as handled",
                        "type": "boolean",
                        "default": false,
                        "description": "When false, 'mark as handled' is tracked locally in VS Code only."
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package --no-dependencies",
        "lint": "eslint src --ext ts"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vscode/vsce": "^2.24.0",
        "eslint": "^8.57.0",
        "typescript": "^5.4.0"
    },
    "dependencies": {
        "axios": "^1.7.0"
    }
}
