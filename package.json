{
    "name": "rhodecode-vscode-extension",
    "displayName": "RhodeCode",
    "description": "Connect to RhodeCode: pick server, browse repositories, view branches, work with pull requests and comments.",
    "version": "0.8.1",
    "publisher": "isaackehle",
    "repository": {
        "type": "git",
        "url": "https://github.com/isaackehle/rhodecode-vscode-extension.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onView:rhodecode.pullRequests",
        "onCommand:rhodecode.connect",
        "onCommand:rhodecode.selectRepository",
        "onCommand:rhodecode.openChangeset",
        "onCommand:rhodecode.refresh",
        "onCommand:rhodecode.showPullRequests",
        "onCommand:rhodecode.showComments",
        "onCommand:rhodecode.replyComment",
        "onCommand:rhodecode.markHandled",
        "onCommand:rhodecode.markUnhandled",
        "onCommand:rhodecode.openPullRequest",
        "onCommand:rhodecode.approveAndMerge",
        "onCommand:rhodecode.createPullRequest"
    ],
    "main": "./out/extension",
    "icon": "media/rhodecode-icon.png",
    "contributes": {
        "commands": [
            {
                "command": "rhodecode.refresh",
                "title": "Refresh",
                "category": "RhodeCode",
                "icon": "$(refresh)"
            },
            {
                "command": "rhodecode.showPullRequests",
                "title": "Show Pull Requests",
                "category": "RhodeCode",
                "icon": "$(git-pull-request)"
            },
            {
                "command": "rhodecode.showComments",
                "title": "Show Comments",
                "category": "RhodeCode",
                "icon": "$(comment)"
            },
            {
                "command": "rhodecode.replyComment",
                "title": "Reply to Comment",
                "category": "RhodeCode",
                "icon": "$(reply)"
            },
            {
                "command": "rhodecode.markHandled",
                "title": "Mark Comment Handled",
                "category": "RhodeCode",
                "icon": "$(check)"
            },
            {
                "command": "rhodecode.markUnhandled",
                "title": "Mark Comment Unhandled",
                "category": "RhodeCode",
                "icon": "$(circle-outline)"
            },
            {
                "command": "rhodecode.createPullRequest",
                "title": "Create Pull Request",
                "category": "RhodeCode",
                "icon": "$(git-pull-request-create)"
            },
            {
                "command": "rhodecode.openPullRequest",
                "title": "Open Pull Request in Browser",
                "category": "RhodeCode",
                "icon": "$(globe)"
            },
            {
                "command": "rhodecode.approveAndMerge",
                "title": "Approve and Merge",
                "category": "RhodeCode",
                "icon": "$(git-merge)"
            },
            {
                "command": "rhodecode.connect",
                "title": "Connect to RhodeCode…",
                "category": "RhodeCode",
                "icon": "$(plug)"
            },
            {
                "command": "rhodecode.selectRepository",
                "title": "Select Repository…",
                "category": "RhodeCode",
                "icon": "$(repo)"
            },
            {
                "command": "rhodecode.openChangeset",
                "title": "Open Changeset in Browser",
                "category": "RhodeCode",
                "icon": "$(globe)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "rhodecode",
                    "title": "RhodeCode",
                    "icon": "media/rhodecode-icon.svg"
                }
            ]
        },
        "views": {
            "rhodecode": [
                {
                    "id": "rhodecode.pullRequests",
                    "name": "Pull Requests",
                    "icon": "media/rhodecode-icon.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "rhodecode.refresh",
                    "when": "view == rhodecode.pullRequests",
                    "group": "navigation"
                },
                {
                    "command": "rhodecode.showPullRequests",
                    "when": "view == rhodecode.pullRequests",
                    "group": "navigation"
                },
                {
                    "command": "rhodecode.connect",
                    "when": "view == rhodecode.pullRequests",
                    "group": "navigation@2"
                },
                {
                    "command": "rhodecode.selectRepository",
                    "when": "view == rhodecode.pullRequests",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "rhodecode.showComments",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest",
                    "group": "inline"
                },
                {
                    "command": "rhodecode.openPullRequest",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest",
                    "group": "inline"
                },
                {
                    "command": "rhodecode.approveAndMerge",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest",
                    "group": "inline"
                },
                {
                    "command": "rhodecode.openChangeset",
                    "when": "view == rhodecode.pullRequests && viewItem =~ /branch|tag/",
                    "group": "inline"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "rhodecode.pullRequests",
                "contents": "Connect to your RhodeCode server to browse repositories, branches and pull requests.\n\n[Set up connection…](command:rhodecode.connect)\n[Open Settings](command:workbench.action.openSettings?%5B%22rhodecode.serverurl%22%5D)",
                "when": "view == rhodecode.pullRequests && !config.rhodecode.serverurl"
            }
        ],
        "configuration": [
            {
                "title": "RhodeCode Configuration",
                "properties": {
                    "rhodecode.serverurl": {
                        "title": "Server URL",
                        "type": "string",
                        "default": "",
                        "description": "RhodeCode server URL (e.g. https://rhodecode.example.com). Set automatically by the Connect wizard."
                    },
                    "rhodecode.apikey": {
                        "title": "API Key",
                        "type": "string",
                        "default": "",
                        "description": "RhodeCode API key, found in your user profile on the server (My Account → Auth Tokens). Set automatically by the Connect wizard. Ignored when 'API Key From Environment File' is enabled."
                    },
                    "rhodecode.apikeyFromEnv": {
                        "title": "API Key From Environment File",
                        "type": "boolean",
                        "default": false,
                        "description": "Read RHODECODE_API_KEY from a .env file (workspace .env first, then ~/.env) instead of the rhodecode.apikey setting. When enabled, rhodecode.apikey is ignored so the key can stay out of a repo's .vscode/settings."
                    },
                    "rhodecode.markHandledPostsComment": {
                        "title": "Post a Reply Comment When Marking Handled",
                        "type": "boolean",
                        "default": false,
                        "description": "When false, 'mark as handled' is tracked locally in VS Code only."
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "prepackage": "bun run test",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "bun run scripts/test-envfile.ts && node scripts/test-extension-load.cjs",
        "package": "vsce package --no-dependencies",
        "lint": "oxlint src",
        "lint:md": "rumdl check .",
        "format": "oxfmt --write \"src/**/*.ts\"",
        "format:check": "oxfmt --check \"src/**/*.ts\"",
        "format:md": "rumdl fmt ."
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^2.24.0",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "typescript": "^5.4.0"
    }
}
