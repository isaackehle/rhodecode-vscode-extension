{
    "categories": [
        "Other"
    ],
    "contributes": {
        "commands": [
            {
                "category": "RhodeCode",
                "command": "rhodecode.refresh",
                "icon": "$(refresh)",
                "title": "Refresh"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.showPullRequests",
                "icon": "$(git-pull-request)",
                "title": "Show Pull Requests"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.showComments",
                "icon": "$(comment)",
                "title": "Show Comments"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.replyComment",
                "icon": "$(reply)",
                "title": "Reply to Comment"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.markHandled",
                "icon": "$(check)",
                "title": "Mark Comment Handled"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.markUnhandled",
                "icon": "$(circle-outline)",
                "title": "Mark Comment Unhandled"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.createPullRequest",
                "icon": "$(git-pull-request-create)",
                "title": "Create Pull Request"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.openPullRequest",
                "icon": "$(globe)",
                "title": "Open Pull Request in Browser"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.approveAndMerge",
                "icon": "$(git-merge)",
                "title": "Approve and Merge"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.connect",
                "icon": "$(plug)",
                "title": "Connect to RhodeCode…"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.openDebugOutput",
                "icon": "$(output)",
                "title": "Show Debug Output"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.selectRepository",
                "icon": "$(repo)",
                "title": "Select Repository…"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.openRepoBrowser",
                "icon": "$(list-flat)",
                "title": "Open Repository Browser"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.openChangeset",
                "icon": "$(globe)",
                "title": "Open Changeset in Browser"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.openCurrentBranchPr",
                "icon": "$(git-pull-request)",
                "title": "Open Pull Request for Current Branch"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.createPrForCurrentBranch",
                "icon": "$(git-pull-request-create)",
                "title": "Create Pull Request for Current Branch"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.addMessage",
                "icon": "$(comment)",
                "title": "Add Message"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.toggleGroup",
                "icon": "$(check)",
                "title": "Toggle Group Filter"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.selectRepoFromTree",
                "icon": "$(repo)",
                "title": "Select Repository"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.switchBranch",
                "icon": "$(git-branch)",
                "title": "Switch to Branch"
            },
            {
                "category": "RhodeCode",
                "command": "rhodecode.switchTag",
                "icon": "$(tag)",
                "title": "Switch to Tag"
            }
        ],
        "configuration": [
            {
                "properties": {
                    "rhodecode.apikey": {
                        "default": "",
                        "description": "RhodeCode API key, found in your user profile on the server (My Account → Auth Tokens). Set automatically by the Connect wizard. Ignored when 'API Key From Environment File' is enabled.",
                        "title": "API Key",
                        "type": "string",
                        "when": "rhodecode.apikeyFromEnv != true"
                    },
                    "rhodecode.apikeyFromEnv": {
                        "default": false,
                        "description": "Read RHODECODE_API_KEY from a .env file (workspace .env first, then ~/.env) instead of the rhodecode.apikey setting. When enabled, rhodecode.apikey is ignored so the key can stay out of a repo's .vscode/settings.",
                        "title": "API Key From Environment File",
                        "type": "boolean"
                    },
                    "rhodecode.markHandledPostsComment": {
                        "default": false,
                        "description": "Also post a \"Marked as handled\" reply comment on the PR thread when you mark a comment handled. When disabled, handled state is tracked locally only.",
                        "title": "Mark Handled Posts Comment",
                        "type": "boolean"
                    },
                    "rhodecode.pushTips": {
                        "default": true,
                        "description": "After pushing a branch, show a notification linking to its open pull request, or offering to create one if it doesn't have one yet.",
                        "title": "Push Tips",
                        "type": "boolean"
                    },
                    "rhodecode.serverurl": {
                        "default": "",
                        "description": "RhodeCode server URL (e.g. https://rhodecode.example.com). Set automatically by the Connect wizard.",
                        "title": "Server URL",
                        "type": "string"
                    },
                    "rhodecode.debug": {
                        "default": false,
                        "description": "Enable debug logging to the RhodeCode output channel (View → Output → RhodeCode). Useful for troubleshooting connection and API issues.",
                        "title": "Debug Logging",
                        "type": "boolean"
                    }
                },
                "title": "RhodeCode Configuration"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "rhodecode.addMessage",
                    "group": "navigation",
                    "when": "editorFocus"
                }
            ],
            "view/item/context": [
                {
                    "command": "rhodecode.showComments",
                    "group": "inline",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest"
                },
                {
                    "command": "rhodecode.openPullRequest",
                    "group": "inline",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest"
                },
                {
                    "command": "rhodecode.approveAndMerge",
                    "group": "inline",
                    "when": "view == rhodecode.pullRequests && viewItem == pullrequest"
                },
                {
                    "command": "rhodecode.openChangeset",
                    "group": "inline",
                    "when": "view == rhodecode.pullRequests && viewItem =~ /branch|tag/"
                },
                {
                    "command": "rhodecode.switchBranch",
                    "group": "inline",
                    "when": "view == rhodecode.pullRequests && viewItem =~ /branch/"
                },
                {
                    "command": "rhodecode.switchTag",
                    "group": "inline",
                    "when": "view == rhodecode.pullRequests && viewItem =~ /tag/"
                }
            ],
            "view/title": [
                {
                    "command": "rhodecode.refresh",
                    "group": "navigation",
                    "when": "view == rhodecode.pullRequests"
                },
                {
                    "command": "rhodecode.showPullRequests",
                    "group": "navigation",
                    "when": "view == rhodecode.pullRequests"
                },
                {
                    "command": "rhodecode.connect",
                    "group": "navigation@2",
                    "when": "view == rhodecode.pullRequests"
                },
                {
                    "command": "rhodecode.selectRepository",
                    "group": "navigation@3",
                    "when": "view == rhodecode.pullRequests"
                },
                {
                    "command": "rhodecode.openRepoBrowser",
                    "group": "navigation@4",
                    "when": "view == rhodecode.pullRequests"
                }
            ]
        },
        "views": {
            "rhodecode": [
                {
                    "icon": "media/rhodecode-icon.svg",
                    "id": "rhodecode.pullRequests",
                    "name": "RhodeCode",
                    "description": "Browse repositories, groups, branches, and pull requests"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "icon": "media/rhodecode-icon.svg",
                    "id": "rhodecode",
                    "title": "RhodeCode"
                }
            ]
        },
        "viewsWelcome": [
            {
                "contents": "Connect to your RhodeCode server to browse repositories, branches and pull requests.\n\n[Set up connection…](command:rhodecode.connect)\n[Open Settings](command:workbench.action.openSettings?%5B%22rhodecode.serverurl%22%5D)\n\n**Need help?**\n- Open the [Debug Output](command:rhodecode.openDebugOutput) to see what's happening\n- Check the [Settings](command:workbench.action.openSettings?%5B%22rhodecode.serverurl%22%5D) for configuration options",
                "view": "rhodecode.pullRequests",
                "when": "view == rhodecode.pullRequests && !config.rhodecode.serverurl"
            }
        ]
    },
    "dependencies": {
        "@types/mocha": "^10.0.10",
        "glob": "^13.0.6",
        "mocha": "^11.8.0"
    },
    "description": "Connect to RhodeCode: pick server, browse repositories, view branches, work with pull requests and comments.",
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.80.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "typescript": "^5.4.0",
        "vscode-test": "^1.6.1"
    },
    "displayName": "RhodeCode",
    "engines": {
        "vscode": "^1.80.0"
    },
    "icon": "media/rhodecode-icon.png",
    "main": "./out/extension",
    "name": "rhodecode-vscode-extension",
    "publisher": "isaackehle",
    "repository": {
        "type": "git",
        "url": "https://github.com/isaackehle/rhodecode-vscode-extension.git"
    },
    "scripts": {
        "clean": "rm -rf out .vscode-test .rumdl_cache && find . -maxdepth 1 -name '*.vsix' -delete",
        "compile": "tsc -p ./",
        "format": "oxfmt --write \"src/**/*.ts\"",
        "format:check": "oxfmt --check \"src/**/*.ts\"",
        "format:md": "rumdl fmt .",
        "lint": "oxlint src",
        "lint:md": "rumdl check .",
        "package": "vsce package --no-dependencies",
        "release": "./scripts/release.sh",
        "test": "bun run scripts/run-tests.cjs",
        "test:integration": "node out/test/runTests.js",
        "test:unit": "bun test",
        "vscode:prepublish": "bun run compile",
        "watch": "tsc -watch -p ./"
    },
    "version": "0.16.2"
}
