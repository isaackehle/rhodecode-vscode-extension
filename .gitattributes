# Auto detect text files and perform LF normalization
* text=auto

# Ensure these files use LF line endings (Unix-style)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.tsx text eol=lf
*.ts text eol=lf

# Binary files should not be normalized
*.png binary
*.ico binary
*.vsix binary
